{
  "mcpServers": {
    "cclo-channel-push": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CC_SUITE_PACKAGE_ROOT:?explicit package root required}/scripts/launch_channel.sh\" \"$@\"",
        "ccsuite-channel",
        "cclo",
        "push"
      ],
      "env": {
        "AGENT_PORT": "8796",
        "RELAY_PORT": "8796"
      }
    },
    "cclo-channel": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CC_SUITE_PACKAGE_ROOT:?explicit package root required}/scripts/launch_channel.sh\" \"$@\"",
        "ccsuite-channel",
        "cclo",
        "relay"
      ],
      "env": {
        "AGENT_PORT": "8796",
        "RELAY_PORT": "8796"
      }
    }
  }
}
