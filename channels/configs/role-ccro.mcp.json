{
  "mcpServers": {
    "ccro-channel-push": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CC_SUITE_PACKAGE_ROOT:?explicit package root required}/scripts/launch_channel.sh\" \"$@\"",
        "ccsuite-channel",
        "ccro",
        "push"
      ],
      "env": {
        "AGENT_PORT": "8793",
        "RELAY_PORT": "8793"
      }
    },
    "ccro-channel": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"${CC_SUITE_PACKAGE_ROOT:?explicit package root required}/scripts/launch_channel.sh\" \"$@\"",
        "ccsuite-channel",
        "ccro",
        "relay"
      ],
      "env": {
        "AGENT_PORT": "8793",
        "RELAY_PORT": "8793"
      }
    }
  }
}
